# ---- Sifalo Pay (checkout) ----
# Staging keys: https://pay.sifalo.net/business   Live keys: https://pay.sifalo.com/business
# Staging and live keys are different: SIFALO_ENV=staging for test keys, live for real keys.
SIFALO_ENV=live
SIFALO_API_USER=
SIFALO_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Sanity (DOTS Admin at /studio) ----
# From https://www.sanity.io/manage -> your project
NEXT_PUBLIC_SANITY_PROJECT_ID=2qlh6ksz
NEXT_PUBLIC_SANITY_DATASET=production
# API -> Tokens -> "Editor". Used to save orders (checkout) and by scripts/seed.mjs.
# Server-only: add it to Vercel too, but never prefix it with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=
# Optional: secret for the instant-update webhook (/api/revalidate)
SANITY_REVALIDATE_SECRET=

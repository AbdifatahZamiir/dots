# ---- Stripe (checkout) ----
# https://dashboard.stripe.com/test/apikeys (use the test key while building)
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Sanity (DOTS Admin at /studio) ----
# From https://www.sanity.io/manage -> your project
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Only needed to run scripts/seed.mjs once (API -> Tokens -> "Editor"). Keep it secret.
SANITY_API_WRITE_TOKEN=
# Optional: secret for the instant-update webhook (/api/revalidate)
SANITY_REVALIDATE_SECRET=
